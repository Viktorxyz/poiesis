{
  "schema": 1,
  "poiesisVersion": "<installed-version>",
  "adapter": {
    "harness": "opencode",
    "adapterVersion": "<adapter-version>",
    "supportedVersion": "<supported-opencode-version>"
  },
  "files": [
    {
      "path": "<managed-path>",
      "kind": "canonical|generated",
      "hash": "<sha256>",
      "owned": true,
      "durable": "<true only for adapter-tracked project files>"
    }
  ],
  "skills": [
    {
      "source": "<upstream-source>",
      "name": "<skill-name>",
      "path": ".agents/skills/<skill-name>",
      "preexisting": false,
      "installedRevision": "<revision-or-preexisting>",
      "hash": "<sha256>"
    }
  ],
  "configPatches": [
    {
      "file": "opencode.jsonc|opencode.json|.opencode/opencode.jsonc|.opencode/opencode.json",
      "path": ["<json>", "<path>"],
      "previousExists": false,
      "previous": "<previous-value-if-previousExists>",
      "installed": "<current-adapter-value>"
    }
  ]
}
